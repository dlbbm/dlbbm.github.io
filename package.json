{
  "name": "dlbbm",
  "private": true,
  "description": "De la bien bonne musique",
  "type": "module",
  "author": "Maxime Fabas",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/dlbbm/dlbbm.github.io"
  },
  "scripts": {
    "start": "npm run build && npx concurrently -n watch,serve \"npm run watch:src\" \"npm run serve:dist\"",
    "build": "npm run build:data && npm run build:src && npm run build:shells",
    "deploy": "npm run build:scripts && node scripts/deploy/index.js",
    "typecheck": "npm run check:scripts && npm run check:src",
    "check:scripts": "npx tsc -p .",
    "check:src": "npx tsc -p src",
    "clean:scripts": "find scripts shared -name '*.js' -delete",
    "build:scripts": "npm run clean:scripts && npx tsc -p scripts",
    "build:data": "npm run build:scripts && node scripts/build-data/index.js",
    "build:src": "npm run build:scripts && DLBBM_MODE=production node scripts/build-src/index.js",
    "build:shells": "npm run build:scripts && node scripts/build-shells/index.js",
    "watch:src": "ESBUILD_WATCH=true node scripts/build-src/index.js",
    "serve:dist": "npx http-server dist --port ${PORT:-3000} -c-1 --ext html",
    "post": "npm run post:create",
    "post:create": "npm run build:scripts && node scripts/post-create/index.js",
    "post:edit": "npm run build:scripts && node scripts/post-edit/index.js",
    "list": "npm run build:scripts && node scripts/list/index.js",
    "list:posts": "npm run list -- posts",
    "list:recordings": "npm run list -- recordings",
    "list:songs": "npm run list -- songs",
    "list:artists": "npm run list -- artists",
    "list:slugs": "npm run list -- slugs",
    "data:generate-slugs": "npm run build:scripts && node scripts/data-generate-slugs/index.js",
    "data:import": "npm run build:scripts && node scripts/data-import/index.js",
    "data:review": "npm run build:scripts && node scripts/data-review/index.js",
    "data:generate-test-data": "npm run build:scripts && node scripts/data-generate-test-data/index.js"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@design-edito/tools": "^0.5.42",
    "@inquirer/prompts": "^8.7.4",
    "@mxfb/tools": "^1.0.8",
    "preact": "^10.29.8",
    "wouter-preact": "^3.13.0"
  }
}
